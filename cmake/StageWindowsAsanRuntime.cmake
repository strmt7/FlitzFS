cmake_minimum_required(VERSION 3.22)

function(require_asan_runtime path)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR
      "MSVC AddressSanitizer runtime is missing: ${path}\n"
      "Restore the selected toolset's AddressSanitizer component, then rebuild.")
  endif()
  file(SHA256 "${path}" actual_sha256)
  if(NOT actual_sha256 STREQUAL expected_sha256)
    message(FATAL_ERROR
      "MSVC AddressSanitizer runtime differs from the configured toolset: ${path}\n"
      "Reconfigure and rebuild the selected FlitzFS configuration.")
  endif()
endfunction()

function(publish_asan_runtime staged)
  string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef cookie)
  set(candidate "${staged}.${cookie}.tmp")
  file(COPY_FILE "${runtime}" "${candidate}" RESULT copy_result)
  if(NOT copy_result STREQUAL "0")
    file(REMOVE "${candidate}")
    message(FATAL_ERROR "Could not stage MSVC AddressSanitizer runtime at ${staged}: ${copy_result}")
  endif()
  file(SHA256 "${candidate}" candidate_sha256)
  if(NOT candidate_sha256 STREQUAL expected_sha256)
    file(REMOVE "${candidate}")
    message(FATAL_ERROR "MSVC AddressSanitizer runtime changed during staging: ${runtime}")
  endif()

  # Publish only verified bytes. Preflight never replaces an existing file,
  # including one another build or test run just staged.
  if(preflight)
    file(RENAME "${candidate}" "${staged}" NO_REPLACE RESULT publish_result)
    if(publish_result STREQUAL "NO_REPLACE")
      file(REMOVE "${candidate}")
      return()
    endif()
  else()
    file(RENAME "${candidate}" "${staged}" RESULT publish_result)
  endif()
  if(NOT publish_result STREQUAL "0")
    file(REMOVE "${candidate}")
    message(FATAL_ERROR "Could not publish MSVC AddressSanitizer runtime at ${staged}: ${publish_result}")
  endif()
endfunction()

file(STRINGS "${manifest}" output_directories ENCODING UTF-8)
list(REMOVE_ITEM output_directories "")
list(REMOVE_DUPLICATES output_directories)
if(NOT output_directories)
  if(preflight)
    message(FATAL_ERROR "No runtime output directories recorded in ${manifest}. Reconfigure and rebuild.")
  endif()
  return()
endif()

cmake_path(GET runtime FILENAME runtime_name)
set(source_verified OFF)
if(NOT preflight)
  require_asan_runtime("${runtime}")
  set(source_verified ON)
endif()
foreach(directory IN LISTS output_directories)
  set(staged "${directory}/${runtime_name}")
  if(IS_SYMLINK "${staged}" OR IS_DIRECTORY "${staged}")
    message(FATAL_ERROR "MSVC AddressSanitizer runtime destination is not a regular file: ${staged}")
  endif()
  if(EXISTS "${staged}")
    if(preflight)
      require_asan_runtime("${staged}")
      continue()
    endif()
    file(SHA256 "${staged}" staged_sha256)
    if(staged_sha256 STREQUAL expected_sha256)
      continue()
    endif()
  endif()
  if(NOT source_verified)
    require_asan_runtime("${runtime}")
    set(source_verified ON)
  endif()
  if(preflight)
    if(NOT IS_DIRECTORY "${directory}")
      message(FATAL_ERROR "MSVC AddressSanitizer output directory missing: ${directory}. Build this configuration first.")
    endif()
  else()
    file(MAKE_DIRECTORY "${directory}")
  endif()
  publish_asan_runtime("${staged}")
  require_asan_runtime("${staged}")
endforeach()
